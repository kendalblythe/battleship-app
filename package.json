{
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "yarn scss:types && turbo run build",
    "dev": "concurrently --raw \"yarn scss:types:watch\" \"turbo run dev\"",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,ts,tsx,json,md}\"",
    "scss:types": "typed-scss-modules packages/battleship-ui --updateStaleOnly --ignore \"**/node_modules/**\"",
    "scss:types:watch": "yarn scss:types --watch"
  },
  "devDependencies": {
    "@thelabnyc/typed-scss-modules": "8.2.4",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.4",
    "prettier": "3.6.2",
    "sass": "1.96.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "apps/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ],
    "packages/battleship-*/**/*.{js,ts,jsx,tsx}": [
      "eslint --fix"
    ]
  },
  "packageManager": "yarn@4.17.0"
}
